{
  "name": "aegis-pulse",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c red,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsup server/index.ts --format esm --platform node --out-dir .dev-server --sourcemap --watch --onSuccess \"node .dev-server/index.js\"",
    "dev:client": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && tsup server/index.ts --format esm --platform node --out-dir dist-server --clean --sourcemap",
    "start": "node dist-server/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "dotenv": "16.6.1",
    "express": "5.1.0",
    "helmet": "8.1.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "concurrently": "9.2.4",
    "prisma": "6.12.0",
    "tsup": "8.5.0",
    "typescript": "5.9.2",
    "vite": "7.3.6"
  }
}
